---
import { useTranslations, localizePath, type Locale } from '../../i18n/utils';
import BookingEmbed from './BookingEmbed.astro';
// `page` labels the submission's origin page in the lead payload — landing
// pages override it so their leads are attributable.
interface Props { lang: Locale; path?: string; refId?: string; page?: string }
const { lang, refId = `website-demo-${lang}`, page = 'book-a-demo' } = Astro.props;
const t = useTranslations(lang);

import { ROLES, COUNTRIES, COMPANY_SIZES, MAIN_CHALLENGES, ESTIMATING_METHODS, BID_FREQUENCIES, NDA_WILLING } from '../../lib/leadScore';

// Chip/select options: wire value = enum slug (validated server-side), label = i18n.
const roleLabel: Record<(typeof ROLES)[number], string> = {
  'company-director': t('demo.form.roleCompanyDirector'), 'estimator': t('demo.form.roleEstimator'),
  'head-of-estimating': t('demo.form.roleHeadOfEstimating'), 'commercial-manager': t('demo.form.roleCommercialManager'),
  'operations-manager': t('demo.form.roleOperationsManager'), 'project-manager': t('demo.form.roleProjectManager'), 'other': t('demo.form.roleOther'),
};
const countryLabel: Record<(typeof COUNTRIES)[number], string> = {
  NL: t('demo.form.countryNL'), BE: t('demo.form.countryBE'), DE: t('demo.form.countryDE'), DK: t('demo.form.countryDK'),
  SE: t('demo.form.countrySE'), NO: t('demo.form.countryNO'), FI: t('demo.form.countryFI'), AT: t('demo.form.countryAT'),
  SI: t('demo.form.countrySI'), HR: t('demo.form.countryHR'), 'EU-OTHER': t('demo.form.countryEUOTHER'), 'NON-EU': t('demo.form.countryNONEU'),
};
const sizeLabel: Record<(typeof COMPANY_SIZES)[number], string> = {
  '1-9': t('demo.form.size1_9'), '10-29': t('demo.form.size10_29'), '30-99': t('demo.form.size30_99'), '100-249': t('demo.form.size100_249'), '250+': t('demo.form.size250'),
};
const challengeLabel: Record<(typeof MAIN_CHALLENGES)[number], string> = {
  'pricing-confidence': t('demo.form.challengePricing'), 'subcontractor-quotes': t('demo.form.challengeSubs'),
  'historical-reuse': t('demo.form.challengeHistory'), 'management-visibility': t('demo.form.challengeMgmt'), 'other': t('demo.form.challengeOther'),
};
const methodLabel: Record<(typeof ESTIMATING_METHODS)[number], string> = {
  excel: t('demo.form.methodExcel'), software: t('demo.form.methodSoftware'), mixed: t('demo.form.methodMixed'), other: t('demo.form.methodOther'),
};
const frequencyLabel: Record<(typeof BID_FREQUENCIES)[number], string> = {
  weekly: t('demo.form.frequencyWeekly'), monthly: t('demo.form.frequencyMonthly'), 'few-per-year': t('demo.form.frequencyFewPerYear'), rarely: t('demo.form.frequencyRarely'),
};
const ndaLabel: Record<(typeof NDA_WILLING)[number], string> = { yes: t('demo.form.ndaYes'), 'not-yet': t('demo.form.ndaNotYet') };
// Locale default for the country select (SL → SI, HR → HR, EN → none) — spec §2 B3.
const defaultCountry = lang === 'sl' ? 'SI' : lang === 'hr' ? 'HR' : '';
const privacyHref = localizePath('/privacy-policy/', lang);
---
<form
  class="form-card"
  id="gv-demo-form"
  novalidate
  data-err={t('demo.form.error')}
  data-err-required={t('demo.form.errRequired')}
  data-err-email={t('demo.form.errEmail')}
  data-sending={t('demo.form.sending')}
>
  <div style="position:absolute;left:-9999px" aria-hidden="true"><label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off"></label></div>
  <input type="hidden" name="locale" value={lang}>
  <input type="hidden" name="page" value={page}>
  <!-- Decorative section rules. The fieldsets/labels already name every control,
       so these add no screen-reader value — only noise; hence aria-hidden. -->
  <p class="form-sec form-sec--first" aria-hidden="true">{t('demo.form.secContact')}</p>
  <div class="field-row">
    <div class="field">
      <label for="fn">{t('demo.form.fullName')} <span class="req" aria-hidden="true">*</span></label>
      <input id="fn" name="fullName" type="text" autocomplete="name" placeholder={t('demo.form.fullNamePlaceholder')} required aria-required="true" aria-describedby="err-fn">
      <p class="field-error" id="err-fn" role="alert" hidden></p>
    </div>
    <div class="field">
      <label for="co">{t('demo.form.company')} <span class="req" aria-hidden="true">*</span></label>
      <input id="co" name="company" type="text" autocomplete="organization" placeholder={t('demo.form.companyPlaceholder')} required aria-required="true" aria-describedby="err-co">
      <p class="field-error" id="err-co" role="alert" hidden></p>
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="em">{t('demo.form.email')} <span class="req" aria-hidden="true">*</span></label>
      <input id="em" name="email" type="email" inputmode="email" autocomplete="email" placeholder={t('demo.form.emailPlaceholder')} required aria-required="true" aria-describedby="err-em">
      <p class="field-error" id="err-em" role="alert" hidden></p>
    </div>
    <div class="field">
      <label for="ph">{t('demo.form.phone')} <span class="opt">({t('demo.form.optional')})</span></label>
      <input id="ph" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder={t('demo.form.phonePlaceholder')}>
    </div>
  </div>
  <p class="form-sec" aria-hidden="true">{t('demo.form.secCompany')}</p>
  <div class="field-row">
    <div class="field">
      <label for="country">{t('demo.form.country')} <span class="req" aria-hidden="true">*</span></label>
      <select id="country" name="country" required aria-required="true" aria-describedby="err-country" autocomplete="country">
        <option value="" disabled selected={defaultCountry === ''}>{t('demo.form.countryPlaceholder')}</option>
        {COUNTRIES.map((c) => (<option value={c} selected={c === defaultCountry}>{countryLabel[c]}</option>))}
      </select>
      <p class="field-error" id="err-country" role="alert" hidden></p>
    </div>
    <fieldset class="field chip-field" role="radiogroup" aria-required="true">
      <legend>{t('demo.form.size')} <span class="req" aria-hidden="true">*</span></legend>
      <div class="chips">
        {COMPANY_SIZES.map((s) => (
          <label class="chip"><input type="radio" name="companySize" value={s} aria-describedby="err-size"><span class="chip-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg></span><span class="chip-lbl">{sizeLabel[s]}</span></label>
        ))}
      </div>
      <p class="field-error" id="err-size" role="alert" hidden></p>
    </fieldset>
  </div>
  <fieldset class="field chip-field" role="radiogroup" aria-required="true">
    <legend>{t('demo.form.role')} <span class="req" aria-hidden="true">*</span></legend>
    <div class="chips">
      {ROLES.map((r) => (
        <label class="chip"><input type="radio" name="role" value={r} aria-describedby="err-role"><span class="chip-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg></span><span class="chip-lbl">{roleLabel[r]}</span></label>
      ))}
    </div>
    <p class="field-error" id="err-role" role="alert" hidden></p>
  </fieldset>
  <fieldset class="field chip-field" role="radiogroup" aria-required="true">
    <legend>{t('demo.form.challenge')} <span class="req" aria-hidden="true">*</span></legend>
    <div class="chips">
      {MAIN_CHALLENGES.map((c) => (
        <label class="chip"><input type="radio" name="mainChallenge" value={c} aria-describedby="err-challenge"><span class="chip-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg></span><span class="chip-lbl">{challengeLabel[c]}</span></label>
      ))}
    </div>
    <p class="field-error" id="err-challenge" role="alert" hidden></p>
  </fieldset>
  <!-- Optional qualifiers (acquisition model §8) — every field is still here and
       still posts; they are folded behind a native <details> so the required
       path reads short. No JS: the disclosure is the browser's own. -->
  <details class="form-more">
    <summary>
      <svg class="more-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      <span class="more-title">{t('demo.form.moreTitle')}</span>
      <span class="more-hint">{t('demo.form.moreHint')}</span>
    </summary>
    <fieldset class="field chip-field">
      <legend>{t('demo.form.method')} <span class="opt">({t('demo.form.optional')})</span></legend>
      <div class="chips">
        {ESTIMATING_METHODS.map((m) => (
          <label class="chip"><input type="radio" name="estimatingMethod" value={m}><span class="chip-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg></span><span class="chip-lbl">{methodLabel[m]}</span></label>
        ))}
      </div>
    </fieldset>
    <fieldset class="field chip-field">
      <legend>{t('demo.form.frequency')} <span class="opt">({t('demo.form.optional')})</span></legend>
      <div class="chips">
        {BID_FREQUENCIES.map((f) => (
          <label class="chip"><input type="radio" name="bidFrequency" value={f}><span class="chip-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg></span><span class="chip-lbl">{frequencyLabel[f]}</span></label>
        ))}
      </div>
    </fieldset>
    <fieldset class="field chip-field">
      <legend>{t('demo.form.nda')} <span class="opt">({t('demo.form.optional')})</span></legend>
      <div class="chips">
        {NDA_WILLING.map((n) => (
          <label class="chip"><input type="radio" name="ndaWilling" value={n}><span class="chip-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg></span><span class="chip-lbl">{ndaLabel[n]}</span></label>
        ))}
      </div>
    </fieldset>
    <div class="field">
      <label for="ms">{t('demo.form.message')} <span class="opt">({t('demo.form.optional')})</span></label>
      <textarea id="ms" name="message" rows="3" placeholder={t('demo.form.messagePlaceholder')}></textarea>
    </div>
  </details>
  <div class="form-foot">
    <button type="submit" class="btn btn-primary">
      <span class="btn-label">{t('demo.form.submit')}</span>
      <span class="arr" aria-hidden="true">→</span>
      <span class="spin" aria-hidden="true"></span>
    </button>
    <p class="consent">{t('demo.form.consent')}</p>
  </div>
  <p class="consent-link"><a href={privacyHref}>{t('footer.bottom.privacy')} →</a></p>
</form>
<div class="form-ok" role="status" aria-live="polite" tabindex="-1">
  <div class="ok-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg></div>
  <h2>{t('demo.success.h3')}</h2>
  <p>{t('demo.success.p')}</p>
  <BookingEmbed lang={lang} refId={refId} />
</div>

<style is:global>
  /* ---- required / optional field markers ---- */
  .form-card .req { color: var(--amber); font-weight: 600; }
  /* --on-ink-2 (>=6.7:1 on the ink-2 card) — --on-ink-3 was 3.23:1, below AA. */
  .form-card .opt { color: var(--on-ink-2); font: 400 12px/1 var(--font-sans); text-transform: none; letter-spacing: 0; }
  /* Success heading retagged h3 -> h2 to remove the h1(page)->h3 heading skip;
     restate the vendored .form-ok h3 look so the visual is unchanged. */
  .form-ok h2 { color: var(--on-ink); font-weight: 600; font-size: 22px; line-height: 1.2; margin: 0 0 10px; }

  /* ---- section rules (Contact / Your company) ----
     Decorative dividers, aria-hidden in the markup. Mono uppercase matches the
     established field-label + legend treatment; --on-ink-2 is 6.7:1 on the card. */
  .form-card .form-sec { display: flex; align-items: center; gap: 14px; margin: 30px 0 18px;
    font: 500 11px/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.16em; color: var(--on-ink-2); }
  .form-card .form-sec::after { content: ""; flex: 1; height: 1px; background: var(--ink-hair-2); }
  .form-card .form-sec--first { margin-top: 0; }

  /* ---- optional-qualifier disclosure (native <details>, zero JS) ---- */
  .form-card .form-more { margin: 28px 0 0; border-top: 1px solid var(--ink-hair-2); }
  .form-card .form-more summary { list-style: none; cursor: pointer; display: flex; align-items: baseline;
    flex-wrap: wrap; gap: 8px 10px; padding: 16px 0; min-height: 44px;
    font: 500 12px/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--on-ink-2); }
  .form-card .form-more summary::-webkit-details-marker { display: none; }
  .form-card .form-more summary:hover .more-title { color: var(--on-ink); }
  .form-card .form-more summary:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; border-radius: var(--radius-md, 8px); }
  .form-card .more-chev { flex: none; align-self: center; transition: transform 140ms; }
  .form-card .form-more[open] .more-chev { transform: rotate(180deg); }
  .form-card .more-hint { font: 400 12px/1.4 var(--font-sans); text-transform: none; letter-spacing: 0;
    color: var(--on-ink-2); }
  .form-card .form-more > .chip-field:first-of-type { margin-top: 6px; }
  .form-card .form-more[open] { padding-bottom: 4px; }
  /* Narrow: the mono title is wider than the row, so let it wrap in place beside
     the chevron (rather than dropping below it and stranding the chevron on its
     own line) and give the hint its own line. */
  @media (max-width: 640px) {
    .form-card .more-title { flex: 1 1 0; min-width: 0; }
    /* padding = chevron (16px) + column gap (10px), so the hint reads as the
       title's sub-line rather than hanging left of it. */
    .form-card .more-hint { flex: 1 1 100%; padding-left: 26px; }
  }
  @media (prefers-reduced-motion: reduce) { .form-card .more-chev { transition: none; } }

  /* ---- submit + consent footer row ----
     site.css:479 `.form-card .btn { width:100%; margin-top:6px }` is (0,2,0);
     the `.form-foot` scope below is (0,3,0), so it wins without !important. */
  .form-card .form-foot { display: flex; align-items: center; gap: 20px; margin-top: 26px;
    border-top: 1px solid var(--ink-hair-2); padding-top: 22px; }
  .form-card .form-foot .consent { flex: 1; margin: 0; }
  .form-card .form-foot .btn { width: auto; min-width: 240px; margin: 0; flex: none; order: 2; }
  @media (max-width: 640px) {
    .form-card .form-foot { flex-direction: column-reverse; align-items: stretch; }
    .form-card .form-foot .btn { width: 100%; }
  }

  /* ---- country select: custom chrome on a still-native <select> ----
     `.form-card .field select` (0,3,1) is required to beat site.css:476's
     `.field select` padding shorthand — a bare `.field select` ties on
     specificity and would be decided by bundle order. */
  .form-card .field select { appearance: none; -webkit-appearance: none;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%2397A6C0' stroke-width='2'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: right 14px center; background-size: 16px 16px;
    padding-right: 42px; }

  /* Customizable select (Chromium 135+): the option list becomes stylable, so the
     dropdown matches the dark card instead of the OS widget. Everywhere else the
     block is inert and the styled trigger above still applies. */
  @supports (appearance: base-select) {
    .form-card .field select { appearance: base-select; background-image: none; padding-right: 14px; }
    /* DESIGN.md "Glow-Signals-Life": the dark chrome carries no slate drop-shadow —
       the picker separates from the card with the next tonal ink plate (--ink-3,
       lighter than both --ink-2 card and --ink page) plus the hairline border. */
    .form-card .field select::picker(select) { appearance: base-select; background: var(--ink-3);
      border: 1px solid var(--ink-hair-2); border-radius: var(--radius-lg, 12px); padding: 6px;
      margin-block: 6px; }
    /* The UA paints a solid triangle here, but every other disclosure affordance
       on the site (this form's own .more-chev, the language picker, the back
       link) is a 2px-stroke chevron. Blank the glyph and mask in the same
       chevron so the control speaks one visual language in both modes. */
    .form-card .field select::picker-icon { content: ""; width: 16px; height: 16px;
      background-color: var(--on-ink-2); transition: rotate 140ms;
      -webkit-mask: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E") center / 16px 16px no-repeat;
      mask: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E") center / 16px 16px no-repeat; }
    .form-card .field select:open::picker-icon { rotate: 180deg; }
    .form-card .field select option { padding: 10px 12px; border-radius: var(--radius-sm, 6px);
      font: 400 15px/1.4 var(--font-sans); color: var(--on-ink); background: transparent; }
    .form-card .field select option:not(:disabled):hover,
    .form-card .field select option:not(:disabled):focus { background: rgba(255, 255, 255, 0.06); }
    .form-card .field select option:checked { color: var(--amber); }
    .form-card .field select option::checkmark { color: var(--amber); }
    .form-card .field select option:disabled { color: var(--on-ink-3); }
    @media (prefers-reduced-motion: reduce) { .form-card .field select::picker-icon { transition: none; } }
  }

  /* ---- qualification chips (single-choice groups rendered on-brand; a native
          radiogroup keeps arrow-key + no-JS behaviour) ---- */
  .chip-field { border: 0; padding: 0; margin: 0 0 18px; min-width: 0; }
  .chip-field legend { padding: 0; display: block; font: 500 12px/1 var(--font-mono);
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--on-ink-2); margin-bottom: 11px; }
  /* .field select is already input-styled in site.css:476 — only the touch target
     and the invalid-group cue are added here. */
  .form-card select { width: 100%; min-height: 44px; }
  .chip-field[aria-invalid="true"] .chip { border-color: var(--danger-on-ink-border); }
  .chips { display: flex; flex-wrap: wrap; gap: 9px; }
  /* .form-card scope (0,2,0) is required: these chips are <label>s inside a
     .field fieldset, and site.css:475 `.field label` (0,1,1) outranked a bare
     `.chip` (0,1,0) — chips rendered as full-width uppercase mono blocks.
     min-height 44px: they are real radio controls (were 35px, below the touch bar). */
  .form-card .chip { position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 44px;
    padding: 9px 14px; border: 1px solid var(--ink-hair-2); border-radius: 999px;
    background: var(--ink); color: var(--on-ink); font: 500 14px/1 var(--font-sans);
    text-transform: none; letter-spacing: 0; margin-bottom: 0;
    cursor: pointer; user-select: none;
    transition: border-color 140ms, background 140ms, color 140ms; }
  .form-card .chip input { position: absolute; width: 1px; height: 1px; opacity: 0; margin: 0; pointer-events: none; }
  .chip:hover { border-color: var(--on-ink-2); }
  .chip-tick { display: inline-flex; width: 0; overflow: hidden; opacity: 0;
    transition: width 140ms, opacity 140ms; }
  .chip:has(input:checked) { background: var(--amber); border-color: var(--amber); color: var(--brand-on-primary); }
  .chip:has(input:checked) .chip-tick { width: 13px; opacity: 1; }
  .chip:has(input:focus-visible) { outline: 2px solid var(--amber); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    /* Must match the raised `.form-card .chip` base rule (0,2,0) or the
       transition it declares keeps winning here. */
    .form-card .chip, .chip-tick { transition: none; }
  }

  /* ---- inline field validation ---- */
  /* .form-card scope (0,2,0) is required: site.css:483 `.demo p` is (0,1,1) and was
     silently winning, so validation errors rendered in grey --on-ink-2 at 16px instead
     of red. Scoping to the form outranks the section rule without !important. */
  .form-card .field-error { color: var(--danger-on-ink); font: 400 12.5px/1.4 var(--font-sans); margin-top: 7px; max-width: none; }
  .form-card .field-error[hidden] { display: none; }
  .field input.invalid, .field select.invalid, .field textarea.invalid { border-color: var(--danger-on-ink-border); }

  /* ---- submit loading state ---- */
  .form-card .btn.is-loading { cursor: default; }
  .form-card .btn .spin { display: none; width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid rgba(26,25,22,0.30); border-top-color: var(--brand-on-primary);
    animation: gv-spin 0.7s linear infinite; }
  .form-card .btn.is-loading .arr { display: none; }
  .form-card .btn.is-loading .spin { display: inline-block; }
  @keyframes gv-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .form-card .btn .spin { animation: none; } }

  /* ---- consent microcopy (contrast-safe on the dark card: --on-ink-2 = 6.7:1) ---- */
  .form-card .consent { margin-top: 18px; font: 400 12.5px/1.55 var(--font-sans); color: var(--on-ink-2); }
  .form-card .consent-link { margin-top: 5px; font: 500 12.5px/1.4 var(--font-mono);
    text-transform: uppercase; letter-spacing: 0.06em; }
  .form-card .consent-link a { color: var(--on-ink-2); }
  .form-card .consent-link a:hover { color: var(--amber); text-decoration: none; }

  /* ---- network error (fetch failure), appended after submit ---- */
  /* same specificity trap as .field-error above — .demo p (0,1,1) was greying this out */
  .form-card .form-net-err { color: var(--danger-on-ink); font-size: 13px; margin-top: 12px; max-width: none; }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('gv-demo-form');
    if (!form) return;
    var ok = form.parentNode.querySelector('.form-ok');
    var booking = ok ? ok.querySelector('.booking') : null;
    var formId = 'gv-demo-form';
    var ctx = { locale: (form.querySelector('input[name="locale"]') || {}).value || '', page: (form.querySelector('input[name="page"]') || {}).value || '' };
    function push(ev) { window.dataLayer = window.dataLayer || []; window.dataLayer.push(ev); }
    // First interaction → qualification_form_start (once per page load).
    var started = false;
    function onStart() { if (started) return; started = true; push({ event: 'qualification_form_start', form_id: formId, locale: ctx.locale, page: ctx.page }); }
    form.addEventListener('input', onStart, true);
    form.addEventListener('change', onStart, true);
    // Campaign ref for Bookings: sanitized utm_campaign (first touch) else the page default. Never personal data.
    function sanitizeRef(v) {
      return String(v || '').toLowerCase().replace(/[^a-z0-9_-]+/g, '-').slice(0, 40).replace(/^-+|-+$/g, '');
    }
    function bookingRef(attr) {
      var def = booking ? (booking.getAttribute('data-ref-default') || '') : '';
      var c = attr && attr.utm_campaign ? sanitizeRef(attr.utm_campaign) : '';
      return c || def;
    }
    var revealed = false;
    function revealBooking(ref) {
      if (!booking || revealed) return;
      revealed = true;
      var base = booking.getAttribute('data-base-src') || '';
      var url = base + '&RefID=' + encodeURIComponent(ref);
      var link = booking.querySelector('.booking-link');
      if (link) link.setAttribute('href', url);
      var frame = booking.querySelector('iframe.booking-frame');
      if (frame) frame.setAttribute('src', url);
      push({ event: 'booking_widget_open', form_id: formId, locale: ctx.locale, page: ctx.page, ref: ref });
      // Scroll the whole success card (heading + calendar) into view; honour reduced motion.
      try {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        (ok || booking).scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      } catch (e) { /* older browsers */ }
    }
    var submitBtn = form.querySelector('button[type="submit"]');
    var btnLabel = submitBtn ? submitBtn.querySelector('.btn-label') : null;

    var errMsg = form.getAttribute('data-err') || 'Something went wrong. Please try again.';
    var reqMsg = form.getAttribute('data-err-required') || 'This field is required.';
    var emailMsg = form.getAttribute('data-err-email') || 'Please enter a valid email address.';
    var sendingMsg = form.getAttribute('data-sending') || 'Sending…';
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // Required set mirrors the server (src/lib/leadPayload.ts).
    var REQUIRED = ['fullName', 'company', 'email', 'country', 'role', 'companySize', 'mainChallenge'];
    var ERR_ID = { fullName: 'err-fn', company: 'err-co', email: 'err-em', country: 'err-country', role: 'err-role', companySize: 'err-size', mainChallenge: 'err-challenge' };
    var RADIO = { role: true, companySize: true, mainChallenge: true };

    function fieldEl(name) { return form.querySelector('[name="' + name + '"]'); }
    function errEl(name) { return document.getElementById(ERR_ID[name]); }
    function fieldValue(name) {
      if (RADIO[name]) { var c = form.querySelector('input[name="' + name + '"]:checked'); return c ? c.value : ''; }
      var el = fieldEl(name); return el ? (el.value || '').trim() : '';
    }
    function markInvalid(name, on) {
      var el = errEl(name);
      if (el) { el.hidden = !on; }
      if (RADIO[name]) {
        var fs = form.querySelector('input[name="' + name + '"]'); fs = fs && fs.closest('fieldset');
        if (fs) { if (on) fs.setAttribute('aria-invalid', 'true'); else fs.removeAttribute('aria-invalid'); }
      } else {
        var input = fieldEl(name);
        if (input) { if (on) { input.setAttribute('aria-invalid', 'true'); input.classList.add('invalid'); } else { input.removeAttribute('aria-invalid'); input.classList.remove('invalid'); } }
      }
    }
    function setError(name, msg) { var el = errEl(name); if (el) el.textContent = msg; markInvalid(name, true); }
    function clearError(name) { var el = errEl(name); if (el) el.textContent = ''; markInvalid(name, false); }
    function validateField(name) {
      var v = fieldValue(name);
      if (!v) { setError(name, reqMsg); return false; }
      if (name === 'email' && !EMAIL_RE.test(v)) { setError(name, emailMsg); return false; }
      clearError(name);
      return true;
    }

    // Text/select fields validate on blur + live after flagged; radio groups clear on change.
    for (var k = 0; k < REQUIRED.length; k++) {
      (function (name) {
        if (RADIO[name]) {
          var radios = form.querySelectorAll('input[name="' + name + '"]');
          for (var j = 0; j < radios.length; j++) radios[j].addEventListener('change', function () { validateField(name); });
          return;
        }
        var input = fieldEl(name);
        if (!input) return;
        input.addEventListener('blur', function () { validateField(name); });
        input.addEventListener(input.tagName === 'SELECT' ? 'change' : 'input', function () {
          if (input.getAttribute('aria-invalid') || input.tagName === 'SELECT') validateField(name);
        });
      })(REQUIRED[k]);
    }

    function setLoading(on) {
      if (!submitBtn) return;
      submitBtn.disabled = on;
      submitBtn.classList.toggle('is-loading', on);
      if (btnLabel && on) { btnLabel.setAttribute('data-label', btnLabel.textContent); btnLabel.textContent = sendingMsg; }
      else if (btnLabel && btnLabel.getAttribute('data-label')) { btnLabel.textContent = btnLabel.getAttribute('data-label'); }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var honeypot = form.querySelector('input[name="company_website"]');
      if (honeypot && honeypot.value) return;

      // ---- Client-side validation: block submit, focus first invalid ----
      var firstInvalid = null, allOk = true;
      for (var r = 0; r < REQUIRED.length; r++) {
        if (!validateField(REQUIRED[r])) { allOk = false; if (!firstInvalid) firstInvalid = RADIO[REQUIRED[r]] ? form.querySelector('input[name="' + REQUIRED[r] + '"]') : fieldEl(REQUIRED[r]); }
      }
      if (!allOk) { if (firstInvalid) firstInvalid.focus(); return; }

      var staleErr = form.querySelector('.form-net-err');
      if (staleErr) staleErr.remove();

      // ---- Harvest (skip unchecked radios/checkboxes so `role` is the picked one) ----
      var data = {};
      var fields = form.querySelectorAll('input, select, textarea');
      for (var i = 0; i < fields.length; i++) {
        var f = fields[i];
        if (!f.name) continue;
        if ((f.type === 'radio' || f.type === 'checkbox') && !f.checked) continue;
        if (f.tagName === 'SELECT' && !f.value) continue;
        data[f.name] = f.value;
      }

      // ---- First-touch attribution (src/scripts/attribution.js) — never block the submit ----
      // Kept in scope: the Bookings RefID is derived from its utm_campaign on success.
      var attr = null;
      try {
        if (typeof window.gvAttribution === 'function') {
          attr = window.gvAttribution();
          for (var a in attr) if (Object.prototype.hasOwnProperty.call(attr, a) && attr[a]) data[a] = attr[a];
        }
      } catch (e) { /* attribution is best-effort */ }

      setLoading(true);

      fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
        .then(function (res) {
          if (!res.ok) throw new Error('request failed');
          return res.json().catch(function () { return {}; });
        })
        .then(function (body) {
          var qualified = !!(body && body.qualified === true);
          var score = body && typeof body.score === 'number' ? body.score : 0;
          push({ event: 'qualification_form_submit', form_id: formId, locale: ctx.locale, page: ctx.page, qualified: qualified, score: score });
          if (qualified) push({ event: 'qualified_lead', form_id: formId, locale: ctx.locale, page: ctx.page, score: score });
          form.style.display = 'none';
          if (ok) { ok.classList.add('show'); ok.focus(); }
          revealBooking(bookingRef(attr));
        })
        .catch(function () {
          setLoading(false);
          var p = document.createElement('p');
          p.className = 'form-net-err';
          p.setAttribute('role', 'alert');
          p.textContent = errMsg;
          form.appendChild(p);
        });
    });
  })();
</script>
