---
// The page's single conversion point. Reuses the site-wide `.demo` chrome and
// grid so the form looks identical to /book-a-demo/, but tags the lead with the
// landing page (`page`) and the campaign reference (`refId`).
import { useTranslations, type Locale } from '../../i18n/utils';
import DemoForm from '../forms/DemoForm.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="book-a-demo" class="demo standalone lp-book">
  <div class="wrap">
    <div class="demo-stack">
      <div class="demo-intro">
        <p class="eyebrow">{t('lp.book.eyebrow')}</p>
        <h2>{t('lp.book.h2')}</h2>
        <p>{t('lp.book.p')}</p>
      </div>
      <div class="demo-form-col">
        <DemoForm lang={lang} page="construction-estimating-software" refId="website-lp" />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* `.demo.standalone` is inert here: its full-viewport centring is declared in
     book-a-demo/index.astro's own is:global block, which only ships on that
     route. The class is kept for parity with /book-a-demo/, and these rules
     state the landing-page geometry outright rather than relying on an
     override — the form is this page's last section, not the whole page. */
  .lp-book.demo.standalone { min-height: auto; display: block; padding: var(--sec) 0;
    scroll-margin-top: 74px; }
  .lp-book .demo-intro h2 { margin: 16px 0 0; }
  /* Stacked layout: the intro is now a header spanning the full wrap-width column, so
     site.css's 380px `.demo p` measure (sized for the old narrow left rail) would
     leave it ragged. DemoIntro.astro carries the same override for /book-a-demo/,
     but its styles never ship on this route — it is not rendered here. */
  .lp-book .demo-intro > p:not(.eyebrow) { max-width: 62ch; }
</style>
