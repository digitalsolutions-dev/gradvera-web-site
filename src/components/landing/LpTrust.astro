---
// Data / trust plate. Dark chrome — the second and last ink section before the
// form, so the page's weight lands where the objection lives.
import { useTranslations, localizePath, type Locale } from '../../i18n/utils';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const pts: string[] = t('lp.trust.pts');
---
<section class="lp-trust">
  <div class="wrap">
    <p class="eyebrow">{t('lp.trust.eyebrow')}</p>
    <h2 class="h-section lp-trust-h2">{t('lp.trust.h2')}</h2>
    <ul class="lp-trust-pts">
      {pts.map((s) => (
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>{s}</span>
        </li>
      ))}
    </ul>
    <p class="lp-trust-company">{t('lp.trust.company')}</p>
    <p class="lp-trust-link"><a href={localizePath('/privacy-policy/', lang)}>{t('lp.trust.privacy')} →</a></p>
  </div>
</section>

<style is:global>
  .lp-trust { background: var(--ink); color: var(--on-ink); padding: var(--sec) 0;
    border-top: 1px solid var(--ink-hair); }
  .lp-trust-h2 { margin-top: 16px; max-width: 20ch; color: var(--on-ink); text-wrap: balance; }
  .lp-trust-pts { list-style: none; margin: clamp(26px, 4vh, 40px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 15px clamp(22px, 3vw, 36px); }
  .lp-trust-pts li { display: flex; gap: 11px; align-items: flex-start;
    font-size: 15px; line-height: 1.55; color: var(--on-ink); }
  .lp-trust-pts svg { flex: none; margin-top: 1px; color: var(--amber); }
  .lp-trust-company { margin: clamp(28px, 4vh, 40px) 0 0; font-size: 15px; line-height: 1.6;
    color: var(--on-ink-2); max-width: 62ch; }
  .lp-trust-link { margin: 10px 0 0; font: 500 12.5px/1.4 var(--font-mono);
    text-transform: uppercase; letter-spacing: 0.06em; }
  .lp-trust-link a { color: var(--on-ink-2); }
  .lp-trust-link a:hover { color: var(--amber); }
</style>
